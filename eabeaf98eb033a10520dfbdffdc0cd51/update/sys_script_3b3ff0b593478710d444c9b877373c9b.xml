        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

    // Ensure the applicant reference and user reference exist
    if (!current.applicant || !current.applicant.user) {
        return;
    }

    var targetUserId = current.applicant.user.toString();
    var targetRoleId = 'eb677bf42f533e10d2a0d68fcea4e3f6'; // Replace with the actual sys_id of the role

    // Check if the user already has this role to prevent duplicates
    var roleGr = new GlideRecord('sys_user_has_role');
    roleGr.addQuery('user', targetUserId);
    roleGr.addQuery('role', targetRoleId);
    roleGr.setLimit(1);
    roleGr.query();

    // Insert the new role if they don't have it
    if (!roleGr.hasNext()) {
        var newRole = new GlideRecord('sys_user_has_role');
        newRole.initialize();
        newRole.user = targetUserId;
        newRole.role = targetRoleId;
        newRole.insert();
    }

})(current, previous);]]></script>
