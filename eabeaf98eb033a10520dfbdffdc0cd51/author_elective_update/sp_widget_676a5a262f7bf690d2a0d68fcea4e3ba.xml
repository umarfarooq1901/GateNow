        <template><![CDATA[<div class="panel panel-default">
  <div class="panel-heading">
    <h3 class="panel-title">Upload Applicant Document</h3>
  </div>
  <div class="panel-body">
    
    <div class="form-group">
      <label>Select a file to attach:</label>
      <input type="file" 
             onchange="angular.element(this).scope().c.onFileSelect(this)" 
             class="form-control" />
    </div>
    
    <div ng-if="c.uploading" class="progress m-t-sm">
      <div class="progress-bar progress-bar-success" 
           role="progressbar" 
           ng-style="{width: c.progress + '%'}">
        Uploading... {{c.progress}}%
      </div>
    </div>

  </div>
</div>]]></template>
