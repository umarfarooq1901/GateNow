<?xml version="1.0" encoding="UTF-8"?><record_update table="sp_widget">
    <sp_widget action="DELETE">
        <category>custom</category>
        <client_script><![CDATA[api.controller = function($scope, $http, spUtil) {
    var c = this;
    
    c.uploading = false;
    c.progress = 0;

    // Target configuration
    var targetTable = 'x_enno_gatenow_service_applicants';
    var targetSysID = 'd721ce192f9bbe10d2a0d68fcea4e305';

    c.onFileSelect = function(inputElement) {
        var files = inputElement.files;
        if (!files || files.length === 0) return;

        var file = files[0];
        c.uploading = true;
        c.progress = 0;
        
        console.log("Starting REST API upload for:", file.name);

        // 1. Prepare the data payload
        var formData = new FormData();
        formData.append('table_name', targetTable);
        formData.append('table_sys_id', targetSysID);
        formData.append('uploadFile', file);

        // 2. Call the Official ServiceNow Attachment API directly
        $http({
            method: 'POST',
            url: '/api/now/attachment/upload', // Official upload endpoint
            headers: {
                // Let the browser automatically set the boundary for multipart/form-data
                'Content-Type': undefined 
            },
            data: formData,
            // Prevent Angular from trying to serialize the FormData object
            transformRequest: angular.identity, 
            uploadEventHandlers: {
                progress: function(e) {
                    if (e.lengthComputable) {
                        c.progress = Math.round((e.loaded / e.total) * 100);
                        $scope.$applyAsync(); // Safely update progress bar
                    }
                }
            }
        }).then(function successCallback(response) {
            // Success!
            c.uploading = false;
            spUtil.addInfoMessage("File uploaded successfully via REST API!");
            console.log("API Success Response:", response.data);
            inputElement.value = ''; // Reset the input
        }, function errorCallback(response) {
            // Error!
            c.uploading = false;
            spUtil.addErrorMessage("Upload failed. Check the console for details.");
            console.error("API Error Response:", response);
            inputElement.value = ''; // Reset the input
        });
    };
};]]></client_script>
