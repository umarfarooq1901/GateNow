        <new_lines_to_html>false</new_lines_to_html>
        <script><![CDATA[(function runMailScript(current, template, email, email_action, event) {
    // Dynamic approval sys_id (current = sysapproval_approver)
    var instanceUrl = gs.getProperty('glide.servlet.uri');
    var approvalSysId = current.sys_id.toString();
    
    // Direct workspace approve/reject URLs
    var approveUrl = instanceUrl + 'x/enno/gatenow-workspace/my-record-page-2/sysapproval_approver/' + approvalSysId + '?sysparm_action=approve';
    var rejectUrl = instanceUrl + 'x/enno/gatenow-workspace/my-record-page-2/sysapproval_approver/' + approvalSysId + '?sysparm_action=reject';
    
    // Styled buttons (OOB style)
    template.print('<table width="100%" cellpadding="10" cellspacing="0" style="border-collapse:collapse;">');
    template.print('  <tr><td style="background:#4CAF50;text-align:center;"><a href="' + approveUrl + '" style="color:white;text-decoration:none;font-weight:bold;">APPROVE</a></td></tr>');
    template.print('  <tr><td style="background:#f44336;text-align:center;"><a href="' + rejectUrl + '" style="color:white;text-decoration:none;font-weight:bold;">REJECT</a></td></tr>');
    template.print('</table>');
    
})(current, template, email, email_action, event);
]]></script>
