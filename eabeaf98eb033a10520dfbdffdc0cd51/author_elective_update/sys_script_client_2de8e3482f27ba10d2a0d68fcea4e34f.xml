        <messages/>
        <name>Restrict Baseline Report Choice</name>
        <order/>
        <script><![CDATA[function onLoad() {
    // GUARD CLAUSE: Only run this script if the GateNow custom field is actually on the form.
    // This prevents the script from impacting standard Out-Of-Box users.
    if (!g_form.hasField('x_enno_gatenow_report_status')) {
        return; 
    }

    // Only apply logic when creating a new report from the related list
    if (g_form.isNewRecord()) {
        
        // Get the Phase value from the parent Project record
        g_form.getReference('project', function(project) {
            
            // Check if Project Phase is NOT 'Initiate' (Standard value is '1')
            if (project.phase != '1') { 
                // Hide 'Baseline Report' and default to 'Monthly Report'
                g_form.removeOption('x_enno_gatenow_report_status', 'baseline_report');
                
                // Note: Make sure 'montly_report' isn't a typo in your dictionary! 
                // If the dictionary value is actually 'monthly_report', you will need to update this string.
                g_form.setValue('x_enno_gatenow_report_status', 'montly_report'); 
            } else {
                // If in Initiate phase, default the selection to 'Baseline Report'
                g_form.setValue('x_enno_gatenow_report_status', 'baseline_report');
            }
        });
    }
}]]></script>
